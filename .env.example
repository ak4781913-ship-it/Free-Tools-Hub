# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are added later.
GEMINI_API_KEY=""

# APP_URL: Automatically injected at runtime in hosted container environments.
APP_URL=""

# VITE_SITE_URL: Verified custom production domain (default fallback: https://freetoolshub1.netlify.app).
# Set this when deploying to a custom domain so <link rel="canonical">, og:url, /sitemap.xml, and /robots.txt use your domain.
VITE_SITE_URL=""

# VITE_GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML verification meta token.
# Paste ONLY the content token value from Search Console (e.g. abc123...) when verifying via HTML tag.
VITE_GOOGLE_SITE_VERIFICATION=""

# VITE_CONTACT_EMAIL: Optional verified owner support email (e.g., hello@yourdomain.com).
# Leave empty if you do not want mailto: links displayed in feedback/contact dialogs.
VITE_CONTACT_EMAIL=""

# Firebase Web App Configuration (Public Client Config for Google Sign-In & Firestore Sync)
# Populate these in local .env or Netlify Site Environment Variables (never commit real .env files).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

