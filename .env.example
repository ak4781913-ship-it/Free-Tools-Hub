# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are added later (never prefix with VITE_).
GEMINI_API_KEY=""

# APP_URL: Optional public server origin URL injected by runtime/hosting environments.
APP_URL=""

# VITE_SITE_URL: Your verified production domain URL (e.g., https://yourdomain.com).
# Must be present during `npm run build` so canonical tags, og:url, sitemap.xml, and robots.txt use your domain.
VITE_SITE_URL=""

# VITE_GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML verification meta token.
# Paste ONLY the content token value from Search Console (e.g. abc123...) when verifying via HTML tag.
VITE_GOOGLE_SITE_VERIFICATION=""

# VITE_CONTACT_EMAIL: Optional verified owner support email (e.g., hello@yourdomain.com).
# Leave empty if you do not want mailto: links displayed in feedback/contact dialogs.
VITE_CONTACT_EMAIL=""

# Firebase Web App Configuration (Public Client Config for Google Sign-In & Firestore Sync)
# Configure these in Hostinger Environment Variables (available during build & runtime) or local .env.
# Never commit real .env files to GitHub. Note: Use VITE_FIREBASE_DATABASE_ID if connecting to a named Firestore DB.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
