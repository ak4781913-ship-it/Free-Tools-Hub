# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are added later.
GEMINI_API_KEY=""

# APP_URL: Automatically injected at runtime in hosted container environments.
APP_URL=""

# VITE_SITE_URL: Verified custom production domain (e.g., https://yourdomain.com, without trailing slash).
# Set this before public launch so <link rel="canonical">, og:url, /sitemap.xml, and /robots.txt use your verified domain.
VITE_SITE_URL=""

# VITE_CONTACT_EMAIL: Optional verified owner support email (e.g., hello@yourdomain.com).
# Leave empty if you do not want mailto: links displayed in feedback/contact dialogs.
VITE_CONTACT_EMAIL=""
